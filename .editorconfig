root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.java]
indent_size = 4
indent_style = space
ij_continuation_indent_size = 8

[*.xml]
indent_size = 4
indent_style = space

[*.yml]
indent_size = 2
indent_style = space

[*.yaml]
indent_size = 2
indent_style = space

[*.sql]
indent_size = 4
indent_style = space

[*.js]
indent_size = 2
indent_style = space

[*.vue]
indent_size = 2
indent_style = space

[*.css]
indent_size = 2
indent_style = space

[*.scss]
indent_size = 2
indent_style = space

[*.less]
indent_size = 2
indent_style = space

[*.json]
indent_size = 2
indent_style = space

[*.drl]
indent_size = 4
indent_style = space

[*.md]
indent_size = 4
indent_style = space
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
