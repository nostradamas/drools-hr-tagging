package rules

import com.northland.drools.matching.model.Employee

// 高级开发者标签规则
rule "高级开发者标签"
    when
        $employee : Employee(workExperience >= 5)
    then
        System.out.println("员工 " + $employee.getName() + " 被标记为：高级开发者");
end

// 中级开发者标签规则
rule "中级开发者标签"
    when
        $employee : Employee(workExperience >= 2 && workExperience < 5)
    then
        System.out.println("员工 " + $employee.getName() + " 被标记为：中级开发者");
end

// 初级开发者标签规则
rule "初级开发者标签"
    when
        $employee : Employee(workExperience < 2)
    then
        System.out.println("员工 " + $employee.getName() + " 被标记为：初级开发者");
end
